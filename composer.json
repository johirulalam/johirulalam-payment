{
    "name": "sayed/payment-laravel",
    "description": "A comprehensive Laravel payment integration package supporting Stripe, PayPal, and Paddle with unified interface, webhooks, and invoice payments",
    "type": "library",
    "keywords": [
        "laravel",
        "payment",
        "stripe",
        "paypal",
        "paddle",
        "integration",
        "webhook",
        "subscription",
        "invoice"
    ],
    "license": "MIT",
    "homepage": "https://github.com/johirulalam/payment",
    "authors": [
        {
            "name": "Johirul Alam",
            "email": "johirulalam@example.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.0",
        "illuminate/support": "^9.0|^10.0|^11.0",
        "illuminate/http": "^9.0|^10.0|^11.0",
        "illuminate/routing": "^9.0|^10.0|^11.0",
        "stripe/stripe-php": "^13.0",
        "guzzlehttp/guzzle": "^7.0"
    },
    "autoload": {
        "psr-4": {
            "Sayed\\Payment\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Sayed\\Payment\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Sayed\\Payment\\PaymentServiceProvider"
            ],
            "aliases": {
                "Payment": "Sayed\\Payment\\Facades\\Payment",
                "Webhook": "Sayed\\Payment\\Facades\\Webhook"
            }
        }
    },
    "scripts": {
        "test": "echo 'No tests configured yet'"
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
