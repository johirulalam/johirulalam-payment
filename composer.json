{
    "name": "sayed/payment-laravel",
    "description": "A Laravel payment integration package with Stripe, PayPal, and Paddle support",
    "type": "library",
    "keywords": [
        "laravel",
        "payment",
        "stripe",
        "paypal",
        "paddle",
        "integration"
    ],
    "license": "Apache-2.0",
    "authors": [
        {
            "name": "Your Name",
            "email": "your.email@example.com"
        }
    ],
    "require": {
        "php": "^8.0",
        "illuminate/support": "^9.0|^10.0|^11.0",
        "illuminate/http": "^9.0|^10.0|^11.0",
        "illuminate/routing": "^9.0|^10.0|^11.0",
        "stripe/stripe-php": "^13.0",
        "guzzlehttp/guzzle": "^7.0"
    },
    "autoload": {
        "psr-4": {
            "Sayed\\Payment\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "Sayed\\Payment\\PaymentServiceProvider"
            ],
            "aliases": {
                "Payment": "Sayed\\Payment\\Facades\\Payment",
                "Webhook": "Sayed\\Payment\\Facades\\Webhook"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
